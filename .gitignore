# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Go-specific (supplements registry-root .gitignore)
*.test
*.out
*.exe
coverage.txt
coverage.html

# Build output
/dist/
/bin/
/${project_name}

# IDE
.vscode/
.idea/

# Local env
.env
.env.local

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# ...but docs/COVERAGE.md is the committed API coverage report (DESIGN-0005), not
# a test artifact. It is un-ignored explicitly because `coverage.*` above matches
# it on a case-insensitive filesystem (macOS) and not on a case-sensitive one
# (CI), which would mean the report is committable on one and invisible on the
# other.
!docs/COVERAGE.md

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.idea/
.vscode/

# Build directories
build/

# Goreleaser snapshot output (created by `make release-local`)
dist/

# pvelab dogfood lab (IMPL-0002): the real config names env vars and site
# topology; the state/env files carry runtime handoff (env holds a password).
# Only the *.example.yaml files are committed.
pvelab.yaml
pvelab-acme.yaml
.pvelab-state.json
# .pvelab.env is GENERATED by `pvelab up` (and removed by `down`) — it is the
# inner suite's env, never an input. Credentials pvelab reads go in
# .pvelab.secrets.env, which nothing overwrites.
.pvelab.env
.pvelab.secrets.env
# Transient lab run logs (`just dogfood-up > dogfood-run.log`) — they name lab
# nodes and are per-run, so they stay local.
*-run.log

# donald-loop runtime state
.claude/donald-loop.local.md

# Old docs
START.md
docs/PE*
